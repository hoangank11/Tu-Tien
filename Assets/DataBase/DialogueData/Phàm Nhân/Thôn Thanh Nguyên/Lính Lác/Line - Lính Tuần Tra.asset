  m_Script: {fileID: 11500000, guid: 73cfb1908ff52cd4e9153bbbf8c068d5, type: 3}
  m_Name: "Line - L\xEDnh Tu\u1EA7n Tra"
  m_EditorClassIdentifier: 
  dialogueGroupName: "L\u1EE5c Th\xE0nh An"
  speaker: {fileID: 11400000, guid: 0cc58b23f8b261a40acbdd63b1b1bf68, type: 2}
  textLine:
  - " Vi\u1EC7c tu\u1EA7n tra c\u0169ng l\xE0 m\u1ED9t nhi\u1EC7m v\u1EE5 h\u1EBFt
    s\u1EE9c quan tr\u1ECDng c\u1EE7a l\xE0ng, ta ph\u1EA3i c\u1ED1 g\u1EAFng nhi\u1EC1u
    th\u1EADt nhi\u1EC1u h\u01A1n n\u1EEFa!!"
  - " \u0110\u1EC3 ta xem xem h\xF4m nay c\xF3 g\xEC kh\xE1c h\u01A1n h\xF4m qua
    kh\xF4ng..."
  - " C\u1EADu nh\xF3c n\u1EBFu c\xF3 r\u1EA3nh th\xEC h\xE3y \u0111i tu\u1EA7n c\xF9ng
    v\u1EDBi ta. ta s\u1EBD gi\xFAp ng\u01B0\u01A1i n\xF3i \u0111\u1EE1 cho quan
    gia \u0111\u1EC3 chi\xEAu m\u1ED9 l\xE0m binh l\xEDnh, nh\u01B0ng tr\u01B0\u1EDBc
    h\u1EBFt ng\u01B0\u01A1i h\xE3y t\u1EADp luy\u1EC7n th\u1EC3 l\u1EF1c \u0111i
    \u0111\xE3. M\u1ED9t con ng\u01B0\u1EDDi kh\u1ECFe m\u1EA1nh th\xEC c\u1EA7n
    t\u1EADp luy\u1EC7n m\u1ED7i ng\xE0y ng\u01B0\u01A1i nh\u1EDB kh\xF4ng?"
  actionType: 0
