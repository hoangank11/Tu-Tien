  m_Name: "Line - Quan Nh\xE2n"
  m_EditorClassIdentifier: 
  dialogueGroupName: "T\u1EEB Ch\xEDnh D\u01B0\u01A1ng"
  speaker: {fileID: 11400000, guid: 4c403a6839773da4796ed3d4fbe2e3a1, type: 2}
  textLine:
  - " Ng\u01B0\u01A1i l\xE0 ng\u01B0\u1EDDi nh\xE0 h\u1ECD H\xE0n c\xF3 ph\u1EA3i
    kh\xF4ng? Ng\u01B0\u01A1i t\u1EDBi \u0111\xE2y t\xECm ta c\xF3 vi\u1EC7c g\xEC
    sao?"
  - " Ta th\u1EA5y ng\u01B0\u01A1i kh\xE1 th\xE2n v\u1EDBi c\xE1c t\u01B0\u1EDBng
    s\u0129 c\u1EE7a ta, n\u1EBFu c\xF3 nguy\u1EC7n c\u1EA7u g\xEC th\xEC c\u1EE9
    n\xF3i."
  - " D\u1EA1o g\u1EA7n \u0111\xE2y ch\xEDnh s\u1EF1 c\xF3 v\u1EBB kh\xF4ng m\u1EA5y
    kh\u1EA3 quan vi\u1EC7c l\xE0m \u0103n c\u1EE7a c\xE1c th\u01B0\u01A1ng gia l\u1EA1i
    \u0111ang b\u1ECB si\u1EBFt ch\u1EB7t t\u1EEB c\xE1c c\u1EA5p b\u1EADc tr\xEAn
    g\u1EEDi v\u1EC1. Th\u1EADt l\xE0 kh\xF3 ngh\u0129..."
  actionLine: 
  actionType: 7
  choiceLine:
  - {fileID: 11400000, guid: 425bd661c49491f4da91d07bd1fc981f, type: 2}
