  dialogueGroupName: "Tr\u01B0\u01A1ng \u0110\u1EA1i L\u1EF1c"
  speaker: {fileID: 11400000, guid: b21c264e29f6cc141b6346820335c6e1, type: 2}
  textLine:
  - "C\u1EADu nh\xF3c c\u1EADu c\u1EA7n g\xEC t\u1EEB ta?"
  - "Ta h\u1ECD Tr\u01B0\u01A1ng T\xEAn L\u1EF1c, c\u1EA3 l\xE0ng g\u1ECDi ta l\xE0
    Tr\u01B0\u01A1ng \u0110\u1EA1i L\u1EF1c"
  - " Ta c\xF3 th\u1EC3 r\xE8n \u0111\u01B0\u1EE3c r\u1EA5t nhi\u1EC1u c\xE1c lo\u1EA1i
    m\xF3n \u0111\u1ED3 \u0111\xF3, tuy nhi\xEAn r\xE8n v\u0169 kh\xED th\xEC l\xE0
    chuy\u1EC7n kh\xE1c, n\u1EBFu mu\u1ED1n th\xEC ta c\xF3 th\u1EC3 n\xF3i nh\u1ECF
    v\u1EDBi ng\u01B0\u01A1i sau! E h\xE8m.. "
