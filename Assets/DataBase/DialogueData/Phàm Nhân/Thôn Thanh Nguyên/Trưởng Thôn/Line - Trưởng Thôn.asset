  m_Script: {fileID: 11500000, guid: 73cfb1908ff52cd4e9153bbbf8c068d5, type: 3}
  m_Name: "Line - Tr\u01B0\u1EDFng Th\xF4n"
  m_EditorClassIdentifier: 
  dialogueGroupName: "L\xFD Tr\u01B0\u1EDFng Th\xF4n"
  speaker: {fileID: 11400000, guid: 106131b2328ad7249a9e8418863540c6, type: 2}
  textLine:
  - " \xC0 H\xE0n nhi \u0111\xF3 h\u1EA3 con, n\u1EBFu r\u1EA3nh c\u1EE9 \u0111\u1EBFn
    nh\xE0 ta d\xF9ng b\u1EEFa c\xF9ng v\u1EDBi hai gi\xE0. \u0110\u1EE9a con c\u1EE7a
    ta c\u0169ng \u0111\xE3 b\u1EADn b\u1ECBu qu\xE1 l\xE2u n\xEAn kh\xF4ng v\u1EC1
    r\u1ED3i. Kh\xF4ng bi\u1EBFt tr\xEAn V\u01B0\u01A1ng \u0110\xF4 n\xF3 hi\u1EC7n
    gi\u1EDD ra sao r\u1ED3i."
  - " M\u1ED7i ng\xE0y s\u1EBD c\xF3 v\xE0i ng\u01B0\u1EDDi trong th\xF4n c\xF3 chuy\u1EC7n
    mu\u1ED1n nh\u1EDD con gi\xFAp \u0111\xF3, n\u1EBFu r\u1EA3nh con c\xF3 th\u1EC3
    t\u1EDBi \u0111\xF3 gi\xFAp h\u1ECD."
  - " V\u01B0\u01A1ng \u0110\xF4 \u0111ang chuy\u1EC7n ch\xEDnh s\u1EF1 ta mong th\xF4n
    m\xECnh v\u1EABn y\xEAn \u1ED5n. Hi\u1EC7n t\u1EA1i d\xE2n s\u1ED1 c\u0169ng
    \u0111\xE3 v\u01A1i \u0111i r\u1ED3i, ng\u01B0\u1EDDi tr\u1EBB hi\u1EC7n gi\u1EDD
    c\u0169ng \u0111\xE3 kh\xF4ng th\u1EA5y c\xF2n mu\u1ED1n n\xE1n l\u1EA1i th\xF4n
    ta n\u1EEFa."
  actionLine: 
  actionType: 7
