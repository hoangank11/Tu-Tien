  m_Name: "Line - Th\u1EE7 Qu\u1EF9"
  m_EditorClassIdentifier: 
  dialogueGroupName: "M\xE3 Th\xE0nh"
  speaker: {fileID: 11400000, guid: 8529eade6d7e9564a983fe4501784bf3, type: 2}
  textLine:
  - "  Nh\xE0 ta r\u1EA5t r\u1ED9ng d\xF9ng \u0111\u1EC3 l\xE0m kho ch\u1EE9a \u0111\u1ED3
    th\xEC th\u1EADt qu\xE1 tuy\u1EC7t v\u1EDDi ph\u1EA3i kh\xF4ng?"
  - " H\xE0n nhi con c\u1EA7n g\xEC \u1EDF ta h\u1EA3?"
  - " D\u1EA1o g\u1EA7n \u0111\xE2y do ch\xEDnh s\u1EF1 n\xEAn vi\u1EC7c l\xE0m \u0103n
    trong th\xF4n hay c\u1EA3 V\u01B0\u01A1ng \u0110\xF4 n\xE0y ch\u1EAFc c\u0169ng
    r\u1EA5t b\u1EA5t \u1ED5n. Th\u1EADt l\xE0 khi\u1EBFn l\xF2ng ng\u01B0\u1EDDi
    g\u1EE5c ng\xE3 m\xE0..."
  actionLine: 
  actionType: 7
